generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Patient journey stages (sequential; LAB is optional, REVIEW follows LAB when ordered)
// REGISTRATION -> VITALS -> CONSULTATION -> (LAB -> REVIEW)? -> PHARMACY -> COMPLETED
model Patient {
  id           String    @id @default(cuid())
  ticket       String    @unique // e.g. MC-025
  name         String
  age          Int?
  phone        String?
  address      String?
  visitType    String    @default("ANTENATAL") // ANTENATAL | POSTNATAL | PAEDIATRIC | ULTRASOUND | GENERAL
  trimester    String? // First | Second | Third
  gestationWk  Int?
  lounge       String? // Lounge A | Lounge B | Lounge C
  seat         String? // Seat number / bed
  priority     String    @default("ROUTINE") // ROUTINE | URGENT | RED
  stage        String    @default("REGISTRATION")
  status       String    @default("WAITING") // WAITING | IN_SERVICE | COMPLETED
  roomId       String? // active room / bay / window e.g. consult-03, vitals-2, lab-1, pharm-1
  stageEnteredAt DateTime @default(now()) // when patient entered current stage
  fastTracked  Boolean   @default(false)
  registeredBy String? // staff name at reception
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vitals       Vitals?
  prescription Prescription?
  events       Event[]
  labTests     LabTest[]
}

model Vitals {
  id         String   @id @default(cuid())
  patientId  String   @unique
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  systolic   Int
  diastolic  Int
  weightKg   Float?
  tempC      Float?
  pulseBpm   Int?
  fetalBpm   Int? // fetal doppler heart rate
  notes      String?
  flagged    Boolean  @default(false) // auto red flag (high BP / fever)
  recordedBy String?
  createdAt  DateTime @default(now())
}

model Prescription {
  id          String    @id @default(cuid())
  patientId   String    @unique
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items       String // JSON array [{drug, dose, freq, duration}]
  notes       String?
  prescribedBy String?
  dispensed   Boolean   @default(false)
  dispensedAt DateTime?
  handedOverBy String?
}

model LabTest {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  panel       String // Complete Haemogram | Urinalysis | Blood Group | Malaria RDT | ...
  status      String   @default("PENDING") // PENDING | PROCESSING | READY
  orderedBy   String?
  resultSummary String?
  createdAt   DateTime @default(now())
  completedAt DateTime?
}

model Event {
  id        String   @id @default(cuid())
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  ticket    String? // denormalised so feed survives patient deletion
  type      String // REGISTER | VITALS_DONE | CONSULT_START | CONSULT_END | LAB_ORDER | LAB_READY | DISPENSED | COMPLETED | ALERT | ACTION | SYSTEM
  title     String
  detail    String?
  meta      String? // JSON blob (tags, lounge, dwell etc.)
  createdAt DateTime @default(now())
}

model Staff {
  id      String  @id @default(cuid())
  name    String
  role    String // Charge Nurse | Triage Nurse | Doctor | Lab Technician | Pharmacist | Sonographer
  station String // RECEPTION | VITALS | CONSULTATION | LAB | PHARMACY
  room    String? // assigned room id if any
  active  Boolean @default(true)
}

model Setting {
  key   String @id
  value String
}
